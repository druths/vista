# Copy to .env and fill in. Generate a secret with:
#   docker compose run --rm --no-deps vista python -m vista secret
#
# VISTA_SECRET_KEY signs sessions AND derives the key that encrypts stored Ark
# tokens. Changing it logs everyone out and makes saved Ark tokens unreadable
# (they must be re-entered with `vista connect`). Back it up.
VISTA_SECRET_KEY=

# Browser origins allowed to call the API. Add the address you actually load
# the web client from — a Tailscale name or IP included.
VISTA_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Where the web client looks for the API. Leave blank to derive it from the
# host the page was served from, which is what you want when the same server
# is reached over loopback and over Tailscale.
VITE_API_BASE=

# Host ports. Change these if something else already listens on them.
VISTA_API_PORT=8800
VISTA_WEB_PORT=5173

# Which host interface to publish on. 127.0.0.1 (the default) keeps Vista on
# this machine. 0.0.0.0 publishes on every interface — including untrusted
# Wi-Fi, not only a VPN. To expose it over Tailscale alone, set this to that
# machine's Tailscale address instead.
VISTA_BIND=127.0.0.1

# Hostnames the Vite dev server will answer to (it 403s unknown Host headers).
VITE_ALLOWED_HOSTS=localhost,127.0.0.1,web
