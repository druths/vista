# Copy to .env and fill in. Generate a secret with:
#   docker compose run --rm --no-deps vista python -m vista secret
#
# VISTA_SECRET_KEY signs sessions AND derives the key that encrypts stored Ark
# tokens. Changing it logs everyone out and makes saved Ark tokens unreadable
# (they must be re-entered with `vista connect`). Back it up.
VISTA_SECRET_KEY=

# Browser origins allowed to call the API.
VISTA_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Where the web client looks for the API.
VITE_API_BASE=http://127.0.0.1:8800

# Host ports. Change these if something else already listens on them.
VISTA_API_PORT=8800
VISTA_WEB_PORT=5173
